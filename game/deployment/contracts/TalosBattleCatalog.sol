pragma solidity ^0.8.30;
import {TalosBattleTypes as T} from "./TalosBattleTypes.sol";
/// @notice Immutable 32-character v1.1 battle configuration, generated from catalog.json.
library TalosBattleCatalog {
    bytes internal constant DATA = hex"";
    function stats(uint8 id) public pure returns (T.Stats memory) { return get(id); }
    function get(uint8 id) internal pure returns (T.Stats memory s) {
        require(id > 0 && id <= 32, "character");
        bytes memory b = DATA;
        uint256 k = uint256(id - 1) * 14;
        s.hp=uint8(b[k]); s.atk=uint8(b[k+1]); s.cost=uint8(b[k+2]);
        s.element=uint8(b[k+3]); s.role=uint8(b[k+4]);
        s.normalRange=uint8(b[k+5]); s.skillRange=uint8(b[k+6]); s.ultimateRange=uint8(b[k+7]);
        s.skillEffect=uint8(b[k+8]); s.skillValue=uint8(b[k+9]);
        s.ultimateEffect=uint8(b[k+10]); s.ultimateValue=uint8(b[k+11]);
        s.ultimateElement=uint8(b[k+12]); s.requiredCasts=uint8(b[k+13]);
    }
}
